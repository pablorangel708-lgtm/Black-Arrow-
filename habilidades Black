local function refreshUI()
	local t = os.clock()
	for _, def in ipairs(ORDER) do
		local p = Config.Powers[def.id]
		local ui = buttons[def.id]
		local remain = math.max(0, (S.cooldowns[def.id] or 0) - t)

		if def.id == "recall" then
			local hrp = getHrp()
			if S.mark and hrp then
				ui.info.Text = string.format("MARCA A %d studs", math.floor((S.mark - hrp.Position).Magnitude))
			else
				ui.info.Text = "SEM MARCA"
			end
		end

		local text, color
		if remain > 0 then
			text, color = string.format("RECARGA %.1fs", remain), THEME.warn
		elseif S.aiming == def.id then
			text, color = "MIRE: TOQUE", THEME.accent
		elseif def.id == "recall" and not S.mark then
			text, color = "SEM MARCA", THEME.dim
		else
			text, color = "PRONTO", THEME.accent
		end
		ui.state.Text = text
		ui.state.TextColor3 = color
		ui.overlay.Size = UDim2.new(1, 0, p.cooldown > 0 and math.clamp(remain / p.cooldown, 0, 1) or 0, 0)
		ui.stroke.Color = (S.aiming == def.id) and THEME.accent or THEME.stroke
		ui.stroke.Thickness = (S.aiming == def.id) and 2 or 1
	end
end

local uiAcc = 0
RunService.Heartbeat:Connect(function(dt)
	updatePortal()
	if S.aiming and os.clock() > S.aimDeadline then S.aiming = nil end
	uiAcc += dt
	if uiAcc >= 0.08 then
		uiAcc = 0
		refreshUI()
	end
end)

RunService.RenderStepped:Connect(function()
	if beacon.Parent then
		beacon.Transparency = 0.45 + 0.2 * math.sin(os.clock() * 3)
	end
end)

