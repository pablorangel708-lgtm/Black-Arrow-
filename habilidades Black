local Powers = {}

function Powers.teleport(pos)
	local ctx = prepare("teleport")
	if not ctx then return end
	moveTo(pos, nil)
	commit(ctx)
end

function Powers.aerial(pos)
	local ctx = prepare("aerial")
	if not ctx then return end
	moveTo(pos, nil)
	commit(ctx)
end

function Powers.combat()
	local ctx = prepare("combat")
	if not ctx then return end
	local cam = Workspace.CurrentCamera
	local camLook = cam and cam.CFrame.LookVector or ctx.hrp.CFrame.LookVector

	local target, tRoot, bestScore
	bestScore = math.huge
	for _, other in ipairs(Players:GetPlayers()) do
		local char = other.Character
		if other ~= player and char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				local offset = root.Position - ctx.hrp.Position
				local d = offset.Magnitude
				if d > 1 then
					local score = d * (2 - offset.Unit:Dot(camLook))
					if score < bestScore then
						target, tRoot, bestScore = char, root, score
					end
				end
			end
		end
	end
	-- sem jogadores: procura NPCs com Humanoid no Workspace
	if not target then
		for _, model in ipairs(Workspace:GetDescendants()) do
			if model:IsA("Humanoid") and model.Health > 0 then
				local char = model.Parent
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root and char ~= getChar() then
					local d = (root.Position - ctx.hrp.Position).Magnitude
					if d > 1 and d < bestScore then
						target, tRoot, bestScore = char, root, d
					end
				end
			end
		end
	end
	if not target then return showToast("Nenhum alvo encontrado.", false) end

	local look = flat(tRoot.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local pos = tRoot.Position - look * Config.CombatOffset
	moveTo(pos, tRoot.Position - pos)
	commit(ctx)
end

function Powers.dodge()
	local ctx = prepare("dodge")
	if not ctx then return end
	local look = flat(ctx.hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local dir = flat(ctx.hum.MoveDirection) or -look
	moveTo(ctx.hrp.Position + dir * Config.DodgeDistance, nil)
	commit(ctx)
end

