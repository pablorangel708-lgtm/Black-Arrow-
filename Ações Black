------------------------------------------------------------------
-- UTILITÁRIOS
------------------------------------------------------------------
local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function round(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or THEME.stroke, Thickness = thickness or 1 })
end

-- Remove espaços extras, quebras de linha e limita o tamanho do nome.
local function cleanName(raw)
	local name = tostring(raw or ""):gsub("[\r\n\t]", " ")
	name = name:match("^%s*(.-)%s*$") or ""
	if utf8.len(name) and utf8.len(name) > MAX_NAME_LENGTH then
		name = name:sub(1, utf8.offset(name, MAX_NAME_LENGTH + 1) - 1)
	end
	return name
end

-- Troca [alvo] pelo nome (escapando % para não quebrar o gsub).
local function buildMessage(template, name)
	local safe = name:gsub("%%", "%%%%")
	local msg = template:gsub("%[alvo%]", safe)
	return msg
end

------------------------------------------------------------------
-- ENVIO PARA O CHAT
------------------------------------------------------------------
-- Retorna true somente se o chat aceitou a mensagem; senão false + motivo.
local function sendChatMessage(message)
	-- Sistema novo (TextChatService)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if not general then
			return false, "Canal de chat não encontrado."
		end
		local okCan, canChat = pcall(function()
			return TextChatService:CanUserChatAsync(player.UserId)
		end)
		if okCan and canChat == false then
			return false, "Sua conta não pode usar o chat."
		end
		local ok, err = pcall(function()
			general:SendAsync(message)
		end)
		if ok then return true end
		return false, "O chat recusou o envio."
	end

	-- Sistema antigo (Legacy Chat)
	local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
	local sayEvent = events and events:FindFirstChild("SayMessageRequest")
	if sayEvent then
		local ok = pcall(function()
			sayEvent:FireServer(message, "All")
		end)
		if ok then return true end
		return false, "Falha ao enviar pelo chat antigo."
	end

	return false, "Esta experiência não permite enviar mensagens pelo LocalScript."
end

