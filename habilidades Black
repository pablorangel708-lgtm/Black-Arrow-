------------------------------------------------------------------
-- UTILITÁRIOS
------------------------------------------------------------------
local function new(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if props and props.Parent then inst.Parent = props.Parent end
	return inst
end

local function getChar() return player.Character end
local function getHrp()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
	local c = getChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function flat(v)
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 0.05 then return nil end
	return f.Unit
end

local function rayParams(extra)
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local list = { getChar() }
	if extra then for _, e in ipairs(extra) do table.insert(list, e) end end
	p.FilterDescendantsInstances = list
	p.IgnoreWater = true
	return p
end

local fxFolder = new("Folder", { Name = "BA_Efeitos", Parent = Workspace })

local function hrpOffset()
	local hum, hrp = getHumanoid(), getHrp()
	if not hum or not hrp then return 3 end
	if hum.RigType == Enum.HumanoidRigType.R6 then return 3 end
	return math.max(2.5, hum.HipHeight + hrp.Size.Y / 2)
end

local function belongsToHumanoid(inst)
	local model = inst:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function flash(position)
	local part = new("Part", {
		Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), Material = Enum.Material.Neon,
		Color = THEME.accent, Transparency = 0.3, Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, CastShadow = false, Position = position, Parent = fxFolder,
	})
	TweenService:Create(part, TweenInfo.new(0.4), {
		Size = Vector3.new(0.5, 0.5, 0.5), Transparency = 1,
	}):Play()
	task.delay(0.6, function() part:Destroy() end)
end

