local function refreshUI()
	local t = os.clock()
	local exhaustLeft = math.max(0, S.exhaustedUntil - t)
	local frac = math.clamp(S.energy / Config.MaxEnergy, 0, 1)

	energyFill.Size = UDim2.new(frac, 0, 1, 0)
	if exhaustLeft > 0 then
		energyFill.BackgroundColor3 = THEME.danger
		energyText.Text = string.format("ESGOTADO  %ds", math.ceil(exhaustLeft))
	else
		energyFill.BackgroundColor3 = frac < 0.25 and THEME.warn or THEME.accent
		energyText.Text = string.format("ENERGIA  %d/%d", math.floor(S.energy + 0.5), Config.MaxEnergy)
	end

	local hrp = getHrp()
	for _, def in ipairs(ORDER) do
		local p = Config.Powers[def.id]
		local ui = buttons[def.id]
		local remain = math.max(0, (S.cooldowns[def.id] or 0) - t)
		local cost = p.cost
		local hasMark = S.mark ~= nil

		if def.id == "recall" then
			if hasMark and hrp then
				local d = (S.mark.pos - hrp.Position).Magnitude
				cost = p.cost + d * Config.RecallCostPerStud
				ui.info.Text = string.format("MARCA %dst · %dE", math.floor(d), math.ceil(cost))
			else
				ui.info.Text = "SEM MARCA"
			end
		elseif p.range then
			ui.info.Text = string.format("ALC %d · %dE", math.floor(effectiveRange(def.id)), p.cost)
		end

		local text, color
		if exhaustLeft > 0 then
			text, color = "ESGOTADO", THEME.danger
		elseif remain > 0 then
			text, color = string.format("RECARGA %.1fs", remain), THEME.warn
		elseif S.energy < cost then
			text, color = "SEM ENERGIA", THEME.danger
		elseif S.aiming == def.id then
			text, color = "MIRE: TOQUE", THEME.accent
		elseif def.id == "recall" and not hasMark then
			text, color = "SEM MARCA", THEME.dim
		else
			text, color = "PRONTO", THEME.accent
		end
		ui.state.Text = text
		ui.state.TextColor3 = color
		ui.overlay.Size = UDim2.new(1, 0, p.cooldown > 0 and math.clamp(remain / p.cooldown, 0, 1) or 0, 0)
		ui.stroke.Color = (S.aiming == def.id) and THEME.accent or THEME.stroke
		ui.stroke.Thickness = (S.aiming == def.id) and 2 or 1
	end
end

