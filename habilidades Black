	moveTo(S.mark, nil)
	commit(ctx)
end

-- Portais ---------------------------------------------------------------
local function makePortal(center, dir)
	local base = CFrame.lookAt(center, center + dir) * CFrame.Angles(0, math.pi / 2, 0)
	local model = new("Model", { Name = "BA_Portal", Parent = fxFolder })
	new("Part", {
		Name = "Moldura", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 8.4, 8.4),
		Color = Color3.fromRGB(8, 10, 9), Material = Enum.Material.SmoothPlastic,
		CFrame = base * CFrame.new(-0.12, 0, 0), Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, Parent = model,
	})
	local inner = new("Part", {
		Name = "Passagem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7, 7),
		Color = THEME.accent, Material = Enum.Material.Neon, Transparency = 0.25,
		CFrame = base, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Parent = model,
	})
	new("PointLight", { Color = THEME.accent, Range = 14, Brightness = 2, Parent = inner })
	return model
end

local function destroyPortal()
	if S.portal then
		S.portal.a.model:Destroy()
		S.portal.b.model:Destroy()
		S.portal = nil
	end
end

function Powers.portal(pos)
	local ctx = prepare("portal")
	if not ctx then return end
	local hrp = ctx.hrp
	local look = flat(hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)

	local centerA = hrp.Position + look * Config.PortalEntryDistance
	local centerB = pos
	local dirA = -look
	local dirB = flat(centerA - centerB) or look

	destroyPortal()
	local a = { center = centerA, dir = dirA, exit = centerA + dirA * 4 }
	local b = { center = centerB, dir = dirB, exit = centerB + dirB * 4 }
	a.model, b.model = makePortal(a.center, a.dir), makePortal(b.center, b.dir)
	S.portal = { a = a, b = b, expires = os.clock() + Config.PortalDuration }

	flash(a.center)
	flash(b.center)
	commit(ctx)
	showToast("Portal aberto por " .. Config.PortalDuration .. "s.", true)
end

local function updatePortal()
	local p = S.portal
	if not p then return end
	if os.clock() > p.expires then
		destroyPortal()
		showToast("O portal se fechou.", false)
		return
	end
	local hrp = getHrp()
	if not hrp or os.clock() < S.transitUntil then return end
	local function inside(e)
		local d = hrp.Position - e.center
		return Vector3.new(d.X, 0, d.Z).Magnitude < 3.5 and math.abs(d.Y) < 5
	end
	local dest
	if inside(p.a) then dest = p.b elseif inside(p.b) then dest = p.a end
	if not dest then return end
	S.transitUntil = os.clock() + 2
	moveTo(dest.exit, dest.dir)
end

------------------------------------------------------------------
-- MIRA POR TOQUE (qualquer lugar)
------------------------------------------------------------------
local function setAim(id)
	S.aiming = id
	S.aimDeadline = os.clock() + 12
	showToast("Toque em qualquer lugar: " .. Config.Powers[id].name .. ".", true)
end

local function handleAimTap(screenPos)
	local cam = Workspace.CurrentCamera
	if not S.aiming or not cam then return end
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 5000, rayParams())

	local pos
	if res then
		pos = placeFromHit(res)
	else
		pos = ray.Origin + ray.Direction * 300 -- toque no céu: vai para o ar
	end

	local id = S.aiming
	S.aiming = nil
	local ok, err = pcall(Powers[id], pos)
	if not ok then
		warn("[BlackArrow] erro em " .. id .. ": " .. tostring(err))
		showToast("Erro ao usar o poder.", false)
	end
end

local function activate(def)
	if def.mode ~= "aim" then S.aiming = nil end
	if def.mode == "aim" then
		if S.aiming == def.id then S.aiming = nil return end
		if os.clock() < (S.cooldowns[def.id] or 0) then return showToast("Em recarga.", false) end
		setAim(def.id)
	else
		local ok, err = pcall(Powers[def.id])
		if not ok then
			warn("[BlackArrow] erro em " .. def.id .. ": " .. tostring(err))
			showToast("Erro ao usar o poder.", false)
		end
	end
end

for i, def in ipairs(ORDER) do
	makeButton(def.id, def.label, i, def.info, function() activate(def) end)
end

