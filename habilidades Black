local Powers = {}

local function pointTeleport(id, point)
	local ctx = prepare(id)
	if not ctx then return end
	local res, err = visibleSurface(ctx.hrp, point)
	if not res then return showToast(err, false) end

	local range = effectiveRange(id)
	local dist = (res.Position - ctx.hrp.Position).Magnitude
	if dist > range then
		return showToast(string.format("Fora de alcance (%d/%d).", math.floor(dist), math.floor(range)), false)
	end
	local feetY = ctx.hrp.Position.Y - hrpOffset()
	if math.abs(res.Position.Y - feetY) > ctx.cfg.maxHeight then
		return showToast("Diferença de altura grande demais para este poder.", false)
	end
	local stand, why = standFromHit(res)
	if not stand then return showToast(why, false) end

	moveTo(stand, nil)
	commit(ctx)
end

function Powers.teleport(point) pointTeleport("teleport", point) end
function Powers.aerial(point) pointTeleport("aerial", point) end

function Powers.combat()
	local ctx = prepare("combat")
	if not ctx then return end
	local range = effectiveRange("combat")
	local cam = Workspace.CurrentCamera

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { getChar(), fxFolder }
	local parts = Workspace:GetPartBoundsInRadius(ctx.hrp.Position, range, params)

	local seen, target, tRoot, bestScore = {}, nil, nil, math.huge
	local camLook = cam and cam.CFrame.LookVector or ctx.hrp.CFrame.LookVector
	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not seen[model] then
			seen[model] = true
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				local offset = root.Position - ctx.hrp.Position
				local d = offset.Magnitude
				if d > 1 and d <= range then
					local score = d * (2 - offset.Unit:Dot(camLook))
					if score < bestScore then
						target, tRoot, bestScore = model, root, score
					end
				end
			end
		end
	end
	if not target then return showToast("Nenhum alvo válido ao alcance.", false) end

	local origin = ctx.hrp.Position + Vector3.new(0, 1.5, 0)
	local los = Workspace:Raycast(origin, tRoot.Position - origin, rayParams({ fxFolder }))
	if los and not los.Instance:IsDescendantOf(target) then
		return showToast("Alvo fora da linha de visão.", false)
	end

	local look = flat(tRoot.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local right = flat(tRoot.CFrame.RightVector) or Vector3.new(1, 0, 0)
	local d = Config.CombatOffset
	local candidates = { -look * d, right * d, -right * d, look * d } -- atrás, lados, frente
	for _, offset in ipairs(candidates) do
		local stand = findStandAt(tRoot.Position + offset, 2, 12)
		if stand and math.abs(stand.Y - tRoot.Position.Y) <= 6 then
			moveTo(stand, tRoot.Position - stand)
			commit(ctx)
			return
		end
	end
	showToast("Sem espaço seguro ao redor do alvo.", false)
end

function Powers.dodge()
	local ctx = prepare("dodge")
	if not ctx then return end
	local look = flat(ctx.hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local base = flat(ctx.hum.MoveDirection) or -look
	local perp = Vector3.new(-base.Z, 0, base.X)
	local range = effectiveRange("dodge")
	local directions = { base, perp, -perp, -base }

	for _, dist in ipairs({ range, range * 0.6 }) do
		for _, dir in ipairs(directions) do
			local blocked = Workspace:Raycast(ctx.hrp.Position, dir * dist, rayParams({ fxFolder }))
			if not blocked then
				local stand = findStandAt(ctx.hrp.Position + dir * dist, 2, 10)
				if stand and math.abs(stand.Y - ctx.hrp.Position.Y) <= 8 then
					moveTo(stand, nil)
					commit(ctx)
					return
				end
			end
		end
	end
	showToast("Sem espaço seguro para esquivar.", false)
end

-- Marcação / retorno -------------------------------------------------
local beacon = new("Part", {
	Name = "BA_MarkBeacon", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
	CastShadow = false, Material = Enum.Material.Neon, Color = THEME.accent, Transparency = 0.45,
	Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 5, 5),
})

local function updateBeacon()
	if S.mark then
		beacon.CFrame = CFrame.new(S.mark.pos - Vector3.new(0, hrpOffset() - 0.1, 0))
			* CFrame.Angles(0, 0, math.pi / 2)
		beacon.Parent = Workspace
	else
		beacon.Parent = nil
	end
end

function Powers.mark()
	local ctx = prepare("mark")
	if not ctx then return end
	if ctx.hum.FloorMaterial == Enum.Material.Air then
		return showToast("Fique em solo firme para marcar a posição.", false)
	end
	if isForbidden(ctx.hrp.Position) then
		return showToast("Área proibida para marcação.", false)
	end
	S.mark = { pos = ctx.hrp.Position, time = os.clock() }
	updateBeacon()
	flash(ctx.hrp.Position - Vector3.new(0, 2, 0))
	commit(ctx)
	showToast("Posição marcada.", true)
end

function Powers.recall()
	local hrp = getHrp()
	if not hrp then return end
	if not S.mark then return showToast("Nenhuma marcação ativa.", false) end

	local dist = (S.mark.pos - hrp.Position).Magnitude
	local cost = Config.Powers.recall.cost + dist * Config.RecallCostPerStud
	local ctx = prepare("recall", cost)
	if not ctx then return end

	local range = effectiveRange("recall")
	if dist > range then
		return showToast(string.format("Marcação longe demais (%d/%d).", math.floor(dist), math.floor(range)), false)
	end
	local stand = findStandAt(S.mark.pos, 2, 10)
	if not stand then return showToast("O local da marcação não é mais seguro.", false) end
	if (stand - S.mark.pos).Magnitude > 6 then
		return showToast("O terreno da marcação mudou.", false)
	end
	moveTo(stand, nil)
	commit(ctx)
end

-- Portais ---------------------------------------------------------------
local function makePortal(endpoint)
	local center = endpoint.floor + Vector3.new(0, 3.6, 0)
	local base = CFrame.lookAt(center, center + endpoint.dir) * CFrame.Angles(0, math.pi / 2, 0)
	local model = new("Model", { Name = "BA_Portal", Parent = fxFolder })
	new("Part", {
		Name = "Moldura", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 8.4, 8.4),
		Color = Color3.fromRGB(8, 10, 9), Material = Enum.Material.SmoothPlastic,
		CFrame = base * CFrame.new(-0.12, 0, 0), Anchored = true, CanCollide = false,
		CanQuery = false, CanTouch = false, Parent = model,
	})
	local inner = new("Part", {
		Name = "Passagem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 7, 7),
		Color = THEME.accent, Material = Enum.Material.Neon, Transparency = 0.25,
		CFrame = base, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		Parent = model,
	})
	new("PointLight", { Color = THEME.accent, Range = 14, Brightness = 2, Parent = inner })
	return model
end

local function destroyPortal()
	if S.portal then
		S.portal.a.model:Destroy()
		S.portal.b.model:Destroy()
		S.portal = nil
	end
end

function Powers.portal(point)
	local ctx = prepare("portal")
	if not ctx then return end
	local hrp = ctx.hrp

	local resB, err = visibleSurface(hrp, point)
	if not resB then return showToast(err, false) end

	local range = effectiveRange("portal")
	local dist = (resB.Position - hrp.Position).Magnitude
	if dist > range then
		return showToast(string.format("Fora de alcance (%d/%d).", math.floor(dist), math.floor(range)), false)
	end
	local feetY = hrp.Position.Y - hrpOffset()
	if math.abs(resB.Position.Y - feetY) > ctx.cfg.maxHeight then
		return showToast("Diferença de altura grande demais.", false)
	end
	local standB, whyB = standFromHit(resB)
	if not standB then return showToast(whyB, false) end

	local look = flat(hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)
	local standA, resA
	for _, d in ipairs({ Config.PortalEntryDistance, 4 }) do
		standA, resA = findStandAt(hrp.Position + look * d, 2, 10)
		if standA then break end
	end
	if not standA then return showToast("Sem espaço para abrir o portal à sua frente.", false) end

	local floorA, floorB = resA.Position, resB.Position
	if (floorA - floorB).Magnitude < 8 then
		return showToast("Destino perto demais do portal de entrada.", false)
	end
	local dirA = -look
	local dirB = flat(floorA - floorB) or look
	local exitA = findStandAt(floorA + dirA * 4, 2, 10)
	local exitB = findStandAt(floorB + dirB * 4, 2, 10)
	if not exitA or not exitB then
		return showToast("Sem espaço de saída para o portal.", false)
	end

	destroyPortal()
	local a = { floor = floorA, dir = dirA, exit = exitA, center = floorA + Vector3.new(0, 3.6, 0) }
	local b = { floor = floorB, dir = dirB, exit = exitB, center = floorB + Vector3.new(0, 3.6, 0) }
	a.model, b.model = makePortal(a), makePortal(b)
	S.portal = { a = a, b = b, expires = os.clock() + Config.PortalDuration }

	flash(a.center)
	flash(b.center)
	commit(ctx)
	showToast("Portal aberto por " .. Config.PortalDuration .. "s.", true)
end

-- Atravessar o portal (checagem por proximidade)
local function updatePortal()
	local p = S.portal
	if not p then return end
	if os.clock() > p.expires then
		destroyPortal()
		showToast("O portal se fechou.", false)
		return
	end
	local hrp = getHrp()
	if not hrp or os.clock() < S.transitUntil then return end
	local function inside(e)
		local d = hrp.Position - e.center
		return Vector3.new(d.X, 0, d.Z).Magnitude < 3.5 and math.abs(d.Y) < 5
	end
	local dest
	if inside(p.a) then dest = p.b elseif inside(p.b) then dest = p.a end
	if not dest then return end
	if isForbidden(dest.exit) or not isSpaceFree(dest.exit) then
		S.transitUntil = os.clock() + 1.5
		return showToast("A saída do portal está bloqueada.", false)
	end
	S.transitUntil = os.clock() + 2.5
	moveTo(dest.exit, dest.dir)
end

