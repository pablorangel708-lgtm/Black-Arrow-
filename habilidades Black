------------------------------------------------------------------
-- VALIDAÇÃO DE LOCAIS
------------------------------------------------------------------
local function isForbidden(pos)
	local folder = Workspace:FindFirstChild(Config.ForbiddenFolderName)
	if not folder then return false end
	for _, inst in ipairs(folder:GetDescendants()) do
		if inst:IsA("BasePart") then
			local lp = inst.CFrame:PointToObjectSpace(pos)
			local h = inst.Size / 2
			if math.abs(lp.X) <= h.X and math.abs(lp.Y) <= h.Y and math.abs(lp.Z) <= h.Z then
				return true
			end
		end
	end
	return false
end

local function isSpaceFree(pos)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { getChar(), fxFolder }
	local parts = Workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(2.6, 5.2, 2.6), params)
	for _, part in ipairs(parts) do
		if part.CanCollide then return false end
	end
	return true
end

-- Converte um ponto de superfície em posição segura em pé.
local function standFromHit(res)
	if res.Normal.Y < Config.MinFloorNormalY then
		return nil, "Mire em um piso ou telhado (não em paredes)."
	end
	if belongsToHumanoid(res.Instance) then return nil, "Destino ocupado." end
	if res.Instance:GetAttribute("NoTeleport") == true then return nil, "Superfície proibida." end
	local stand = res.Position + Vector3.new(0, hrpOffset() + 0.15, 0)
	if isForbidden(stand) then return nil, "Área proibida." end
	if not isSpaceFree(stand) then return nil, "Sem espaço livre no destino." end
	return stand
end

local function findStandAt(approx, up, down)
	local origin = approx + Vector3.new(0, up, 0)
	local res = Workspace:Raycast(origin, Vector3.new(0, -(up + down), 0), rayParams({ fxFolder }))
	if not res then return nil, "Sem chão no destino." end
	local stand, why = standFromHit(res)
	if not stand then return nil, why end
	return stand, res
end

-- Só teleporta para locais conhecidos (linha de visão).
local function visibleSurface(hrp, point)
	local origin = hrp.Position + Vector3.new(0, 1.5, 0)
	local offset = point - origin
	local dist = offset.Magnitude
	if dist < 1 then return nil, "Destino muito próximo." end
	local res = Workspace:Raycast(origin, offset.Unit * (dist + 3), rayParams({ fxFolder }))
	if not res or (res.Position - point).Magnitude > 3 then
		return nil, "Local desconhecido: sem linha de visão."
	end
	return res
end

local function moveTo(pos, faceDir)
	local char, hrp = getChar(), getHrp()
	if not char or not hrp then return end
	local look = (faceDir and flat(faceDir)) or flat(hrp.CFrame.LookVector) or Vector3.new(0, 0, -1)
	flash(hrp.Position)
	char:PivotTo(CFrame.lookAt(pos, pos + look))
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	flash(pos)
end

------------------------------------------------------------------
-- ENERGIA, RECARGA E ESGOTAMENTO
------------------------------------------------------------------
local function effectiveRange(id)
	local p = Config.Powers[id]
	if not p or not p.range then return nil end
	local f = Config.MinRangeFactor
		+ (1 - Config.MinRangeFactor) * math.clamp(S.energy / Config.MaxEnergy, 0, 1)
	return p.range * f
end

local function exhaust()
	S.exhaustedUntil = os.clock() + Config.ExhaustDuration
	S.wasExhausted = true
	S.aiming = nil
	showToast("Esgotamento espacial! Poderes bloqueados por " .. Config.ExhaustDuration .. "s.", false)
end

-- Confere tudo antes de usar. Nada é cobrado aqui.
local function prepare(id, costOverride)
	local hum, hrp = getHumanoid(), getHrp()
	if not hum or not hrp or hum.Health <= 0 then
		showToast("Personagem indisponível.", false)
		return nil
	end
	if hum.SeatPart then
		showToast("Não é possível usar poderes sentado.", false)
		return nil
	end
	local t = os.clock()
	if t < S.exhaustedUntil then
		showToast(string.format("Esgotado! Aguarde %.0fs.", S.exhaustedUntil - t), false)
		return nil
	end
	local cfg = Config.Powers[id]
	if t < (S.cooldowns[id] or 0) then
		showToast(string.format("%s em recarga (%.1fs).", cfg.name, S.cooldowns[id] - t), false)
		return nil
	end
	local cost = costOverride or cfg.cost
	if S.energy < cost then
		showToast(string.format("Energia insuficiente (precisa de %d).", math.ceil(cost)), false)
		return nil
	end
	return { id = id, cfg = cfg, cost = cost, hum = hum, hrp = hrp }
end

local function commit(ctx)
	local t = os.clock()
	S.energy = math.max(0, S.energy - ctx.cost)
	S.cooldowns[ctx.id] = t + ctx.cfg.cooldown
	S.lastUse = t
	S.fatigue += ctx.cost
	if S.energy <= 0.01 or S.fatigue >= Config.FatigueLimit then
		exhaust()
	end
end

