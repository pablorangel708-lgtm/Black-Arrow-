------------------------------------------------------------------
-- ENVIO COM PROTEÇÃO CONTRA DUPLICIDADE
------------------------------------------------------------------
local sendLocked = false

local function deliver(message)
	if sendLocked then return end
	sendLocked = true
	task.delay(1.2, function() sendLocked = false end)

	if utf8.len(message) and utf8.len(message) > MAX_CHAT_LENGTH then
		setStatus("Mensagem passa de " .. MAX_CHAT_LENGTH .. " caracteres. Use um nome menor.", false)
		return
	end

	local ok, reason = sendChatMessage(message)
	if ok then
		setStatus("Mensagem enviada ao chat.", true)
	else
		copyReason.Text = reason or "Não foi possível enviar."
		copyBox.Text = message
		copyDialog.Visible = true
		setStatus("Não enviado: " .. (reason or "erro desconhecido"), false)
	end
end

local pendingItem = nil

local function closeTargetDialog()
	pendingItem = nil
	targetDialog.Visible = false
	targetBox:ReleaseFocus()
	targetBox.Text = ""
end

local function submitTarget()
	if not pendingItem then return end
	local name = cleanName(targetBox.Text)
	if name == "" then
		setStatus("Digite o nome do alvo.", false)
		return -- campo vazio: não envia nada
	end
	local message = buildMessage(pendingItem.text, name)
	closeTargetDialog()
	deliver(message)
end

local function openTargetDialog(item)
	pendingItem = item
	targetBox.Text = ""
	copyDialog.Visible = false
	targetDialog.Visible = true
end

sendBtn.Activated:Connect(submitTarget)
cancelBtn.Activated:Connect(closeTargetDialog)
targetBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then submitTarget() end
end)

