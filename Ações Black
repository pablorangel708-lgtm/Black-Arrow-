end)

-- Ajusta o tamanho do painel para telas pequenas
local function applyScale()
	local vp = gui.AbsoluteSize
	if vp.X <= 0 or vp.Y <= 0 then return end
	uiScale.Scale = math.clamp(math.min(vp.Y / (PANEL_H + 30), vp.X / (PANEL_W + 70)), 0.65, 1)
	clampToScreen(panel)
	clampToScreen(floatBtn)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyScale)
