local uiAcc = 0
RunService.Heartbeat:Connect(function(dt)
	local t = os.clock()

	-- energia e esgotamento
	if t >= S.exhaustedUntil then
		if S.wasExhausted then
			S.wasExhausted = false
			S.fatigue = 0
			showToast("Energia espacial estabilizada.", true)
		end
		if t - S.lastUse >= Config.RegenDelay then
			S.energy = math.min(Config.MaxEnergy, S.energy + Config.RegenPerSecond * dt)
		end
		S.fatigue = math.max(0, S.fatigue - Config.FatigueDecay * dt)
	end

	-- marcação expira
	if S.mark and t - S.mark.time > Config.MarkLifetime then
		S.mark = nil
		updateBeacon()
		showToast("A marcação espacial se dissipou.", false)
	end

	updatePortal()

	uiAcc += dt
	if uiAcc >= 0.08 then
		uiAcc = 0
		refreshUI()
	end
end)

