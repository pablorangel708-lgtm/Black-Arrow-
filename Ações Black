------------------------------------------------------------------
-- ARRASTAR (botão flutuante e painel)
------------------------------------------------------------------
local function clampToScreen(obj)
	local vp = gui.AbsoluteSize
	local pos = obj.AbsolutePosition - gui.AbsolutePosition
	local size = obj.AbsoluteSize
	local dx, dy = 0, 0
	if pos.X < 0 then dx = -pos.X elseif pos.X + size.X > vp.X then dx = vp.X - (pos.X + size.X) end
	if pos.Y < 0 then dy = -pos.Y elseif pos.Y + size.Y > vp.Y then dy = vp.Y - (pos.Y + size.Y) end
	if dx ~= 0 or dy ~= 0 then
		obj.Position = UDim2.new(obj.Position.X.Scale, obj.Position.X.Offset + dx,
			obj.Position.Y.Scale, obj.Position.Y.Offset + dy)
	end
end

-- Se soltar sem arrastar, conta como toque (onTap).
local function makeDraggable(handle, target, onTap)
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragging, moved = true, false
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					clampToScreen(target)
					if not moved and onTap then onTap() end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			if delta.Magnitude > 8 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)
end

