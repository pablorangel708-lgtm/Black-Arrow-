local tapStarts = {}

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	local kind = input.UserInputType
	if kind == Enum.UserInputType.Touch or kind == Enum.UserInputType.MouseButton1 then
		tapStarts[input] = { pos = input.Position, time = os.clock() }
	elseif kind == Enum.UserInputType.Keyboard then
		local id = KEYBINDS[input.KeyCode]
		if id then
			for _, def in ipairs(ORDER) do
				if def.id == id then activate(def) end
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	local s = tapStarts[input]
	if not s then return end
	tapStarts[input] = nil
	if S.aiming and (input.Position - s.pos).Magnitude <= 14 and os.clock() - s.time <= 0.6 then
		handleAimTap(input.Position)
	end
end)

local function clampToScreen(obj)
	local vp = gui.AbsoluteSize
	local pos = obj.AbsolutePosition - gui.AbsolutePosition
	local size = obj.AbsoluteSize
	local dx, dy = 0, 0
	if pos.X < 0 then dx = -pos.X elseif pos.X + size.X > vp.X then dx = vp.X - (pos.X + size.X) end
	if pos.Y < 0 then dy = -pos.Y elseif pos.Y + size.Y > vp.Y then dy = vp.Y - (pos.Y + size.Y) end
	if dx ~= 0 or dy ~= 0 then
		obj.Position = UDim2.new(obj.Position.X.Scale, obj.Position.X.Offset + dx,
			obj.Position.Y.Scale, obj.Position.Y.Offset + dy)
	end
end

-- Arrastável; se soltar sem ter arrastado, conta como toque (onTap).
local function makeDraggable(handle, target, onTap)
	local dragging, moved, dragStart, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					clampToScreen(target)
					if not moved and onTap then onTap() end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseMovement or kind == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			if delta.Magnitude > 8 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			end
		end
	end)
end

makeDraggable(header, panel, nil)
makeDraggable(toggleBtn, toggleBtn, function()
	panel.Visible = not panel.Visible
	if not panel.Visible then S.aiming = nil end
end)

local function applyScale()
	local vp = gui.AbsoluteSize
	if vp.X <= 0 or vp.Y <= 0 then return end
	uiScale.Scale = math.clamp(math.min(vp.Y / (PANEL_H + 30), vp.X / (PANEL_W + 110)), 0.65, 1)
	clampToScreen(panel)
	clampToScreen(toggleBtn)
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyScale)
task.defer(applyScale)

player.CharacterAdded:Connect(function()
	S.aiming = nil
end)
